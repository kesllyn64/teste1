            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
    
    button.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
end

